DATABASE_URL=
AUTH_MODE=password
DATABASE_CA_BASE64=
DATABASE_TLS_SERVERNAME=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
APP_COMPANY_ID=
FLOW_MODE=mock
# Select explicitly. Production also requires /v1 and its own credentials.
FLOW_ENVIRONMENT=sandbox
FLOW_BASE_URL=https://openapi.flowaccount.com/test
FLOW_CLIENT_ID=
FLOW_CLIENT_SECRET=
FLOW_API_APPROVED=false
FLOW_PRODUCTION_READ_APPROVED=false
FLOW_SANDBOX_WRITE_APPROVED=false
# Production writes remain blocked until Sandbox acceptance and explicit draft approval.
FLOW_PRODUCTION_WRITE_APPROVED=false
# Install only after explicit owner approval of one saved draft/version/hash.
FLOW_PRODUCTION_DRAFT_ID=
FLOW_PRODUCTION_DRAFT_VERSION=
FLOW_PRODUCTION_REVIEW_HASH=
# Local helper only. Never enable on hosting.
LOCAL_CATALOG_LOGIN_ENABLED=false
MOCK_LOGIN_ENABLED=
MOCK_SCENARIO=
DB_POOL_MAX=
LOCAL_SANDBOX_LOGIN_ENABLED=false
# Administrative writes: set only after the owner confirms this staging target.
CK_DB_ENVIRONMENT=
CK_STAGING_DB_HOST=
CK_STAGING_DB_NAME=
## Separate Production credentials for explicitly approved catalog reads only
FLOW_PRODUCTION_CLIENT_ID=
FLOW_PRODUCTION_CLIENT_SECRET=

# Regular Production writes: stays false until explicit owner go-live approval.
FLOW_PRODUCTION_SUBMISSION_ENABLED=false
# Dedicated Railway worker only; never true in Vercel.
CK_SUBMISSION_WORKER=false
# Separate confirmed production PostgreSQL target (never reused by Preview).
CK_PRODUCTION_DB_HOST=
CK_PRODUCTION_DB_NAME=
DB_POOL_MAX=2
